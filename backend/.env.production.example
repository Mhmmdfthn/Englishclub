# Template env PRODUCTION (Vercel / VPS). Salin ke Environment Variables
# dashboard hosting, JANGAN commit file .env berisi nilai asli.
# Semua flag dibaca saat runtime (tidak perlu rebuild bila diubah),
# KECUALI flag VITE_* di frontend (dibake saat build).

PORT=3001

# Supabase (wajib). SERVICE_ROLE_KEY hanya di server, jangan expose ke Vite.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Secret token untuk Google Apps Script sync endpoint (/api/members/sync).
SUPABASE_SYNC_TOKEN=isi-dengan-string-acak-panjang

# Flag fitur akun anggota publik (register/login/me). unset/true = nyala;
# false = API jawab 503 "segera hadir". Endpoint admin tidak kena flag.
MEMBER_AUTH_ENABLED=true

# Flag fitur absensi QR (check-in/list/mine/active). unset/true = nyala;
# false = API jawab 503 "segera hadir". Endpoint panitia/admin
# (sessions/display-token/close/correct) tidak kena flag.
ATTENDANCE_ENABLED=true

# (Optional) Discord audit push -- tanpa ini modul audit no-op (tidak error)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
DISCORD_TECH_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/zzz
