PORT=3001

# Supabase primary store (PRD DB SUPABASE) -- wajib di Vercel + backend/.env saat cut-over.
# SERVICE_ROLE_KEY hanya di server, jangan expose ke Vite.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Secret token untuk Google Apps Script sync endpoint (/api/members/sync).
# Alternatif: pakai JWT admin (Authorization: Bearer <supabase-jwt>).
SUPABASE_SYNC_TOKEN=your-secret-sync-token

# Flag fitur akun anggota publik (register/login/me). unset/true = nyala;
# false = API jawab 503 "segera hadir". Endpoint admin (whitelist/akun/reset) tidak kena flag.
# MEMBER_AUTH_ENABLED=true

# (Optional) Discord audit push -- tanpa ini modul audit no-op (tidak error)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
DISCORD_TECH_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/zzz
