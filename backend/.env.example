ADMIN_TOKEN=replace-with-a-local-admin-token
PORT=3001

# Vercel KV / Upstash Redis (required for persistent members, leaderboard, stories, and proker on Vercel)
KV_REST_API_URL=https://your-kv-endpoint.upstash.io
KV_REST_API_TOKEN=your-kv-token

# Secret token for Google Apps Script sync endpoint (/api/members/sync)
SYNC_TOKEN=your-secret-sync-token

# (Optional) Discord audit push — tanpa ini modul audit no-op (tidak error)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
DISCORD_TECH_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/zzz

# (Optional) Cloudinary upload permanen foto proker — tanpa ini fallback disk lokal
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
#CLOUDINARY_FOLDER=englishclub/proker

# (Optional) read-write DB englishclub-global-config (Neon/Vercel Postgres) — fallback offline: backend/server/data
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/englishclub-global-config?sslmode=require

# (Optional Legacy) Google Sheets service account — tidak wajib jika menggunakan Google Apps Script sync
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_SHEETS_RANGE=Members!A:D
