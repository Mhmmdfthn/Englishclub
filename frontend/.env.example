# Tidak ada VITE_ADMIN_TOKEN di frontend (auth via /api/admin/verify)
# VITE_API_URL=http://localhost:8000

# (Optional) Link grup WhatsApp pendaftaran — tampil di modal sukses setelah daftar
# VITE_WHATSAPP_LINK=https://chat.whatsapp.com/xxxxx

# Flag fitur akun anggota (dibake saat build; perlu rebuild+Vercel redeploy setelah ubah).
# unset/true = halaman /masuk + /buat-akun normal; false = jadi halaman "Segera Hadir".
# VITE_MEMBER_AUTH_ENABLED=true

# Flag fitur absensi QR di dashboard member (dibake saat build).
# unset/true = tab Absensi normal; false = tab Absensi jadi "Segera Hadir" + badge Segera di menu.
# VITE_ATTENDANCE_ENABLED=true
