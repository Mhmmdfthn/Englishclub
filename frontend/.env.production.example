# Template env PRODUCTION frontend (Vercel).
# PENTING: semua VITE_* dibake saat build -> setiap ubah nilai ini
# WAJIB rebuild + redeploy agar berlaku. Set di Vercel:
# Project Settings > Environment Variables (Production).
# Tidak ada VITE_ADMIN_TOKEN di frontend (auth via /api/admin/verify)

# (Optional) Link grup WhatsApp pendaftaran — tampil di modal sukses setelah daftar
# VITE_WHATSAPP_LINK=https://chat.whatsapp.com/xxxxx

# Flag fitur akun anggota (unset/true = halaman /masuk + /buat-akun normal;
# false = jadi halaman "Segera Hadir").
VITE_MEMBER_AUTH_ENABLED=true

# Flag fitur absensi QR di dashboard member (unset/true = tab Absensi normal;
# false = tab Absensi jadi "Segera Hadir" + badge Segera di menu).
VITE_ATTENDANCE_ENABLED=true
